# Dev only. The production build derives the websocket URL from document.location
# (see components/data/websocket.js), so this value never ships.
# The vite dev server proxies /ws through to the backend, so this points at the
# dev server's own origin rather than at the backend port directly.
REACT_APP_WEBSOCKET_URL="ws://localhost:3000/ws"

# Superseded by build.sourcemap in vite.config.js; kept for reference.
GENERATE_SOURCEMAP=false
